<?xml version="1.0" encoding="utf-8"?>
<!-- SentisWatcher: Instance\SentisWatcher.cfg. Создаётся при первом запуске со значениями по умолчанию. -->
<WatcherConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Записывать ли вообще. -->
  <Enabled>true</Enabled>

  <!-- Сколько дней хранить записи (сегодня считается). Файлы старше удаляются при старте и в полночь UTC. -->
  <RetentionDays>14</RetentionDays>

  <!-- Куда класть суточные файлы. Пусто — Instance\SentisWatcher. -->
  <DatabaseFolder />

  <!-- Веб-представление (карта, ползунок времени, события, инвентари) на http://127.0.0.1:<порт>/ —
       только с этой машины. Изменение — со следующего старта. -->
  <WebEnabled>true</WebEnabled>
  <WebPort>18950</WebPort>

  <!-- Публичная статистика: /online, /perf. 0 — выключено. -->
  <PublicPort>0</PublicPort>
  <PublicOrigin>*</PublicOrigin>

  <!-- Защищённый REST сражений на том же PublicPort: только с этой машины (сайт здесь же или локальный HTTPS
       reverse proxy), с Bearer-ключом на БЭКЕНДЕ сайта, не в браузере. По умолчанию включён. -->
  <PublicBattlesEnabled>true</PublicBattlesEnabled>
  <!-- Абсолютный путь к приватному UTF-8 файлу ключа. Сам ключ в конфиг не помещать. Пусто — Instance\SentisWatcher-Secrets\battles.key,
       Watcher создаёт его при первом старте (доступ: учётка Torch, SYSTEM, администраторы). -->
  <PublicBattlesKeyFile />
  <!-- Задержка после завершения боя: минимум 5, по умолчанию 15 минут. -->
  <PublicBattlesDelayMinutes>15</PublicBattlesDelayMinutes>
  <!-- Страница сражения на сайте: когда сражение опубликовано, его участникам онлайн пишется в чат набрать !br,
       и !br открывает эту страницу с их сражением в оверлее Steam. Пусто - без уведомлений. -->
  <BattleReportPage>https://sentis-project.online/battles.html</BattleReportPage>
</WatcherConfig>
